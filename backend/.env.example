# Copy to .env and fill in. NEVER commit the real .env.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://user:password@host:5432/necpra
DATABASE_SSL=true
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma separated origins of your web/WebGL frontend. Use * only for testing.
CORS_ORIGINS=https://your-frontend.example.com
BANNED_WORDS=
ALLOW_SOLO_ROOMS=false
DAILY_COIN_CAP=3000
TUBE_ROUNDS=5
